DATABASE_URL=postgresql://context_graph:context_graph_local@127.0.0.1:5432/context_graph   # local Compose default; replace with a hosted URL to share a graph
TEST_DATABASE_URL=postgresql://context_graph:context_graph_local@127.0.0.1:5432/context_graph   # keep tests on the local database


# Embedding backend for the context compiler: local (default, in-process ONNX model) or openai
EMBEDDING_PROVIDER=local
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LLM used ONLY for agent context proposals (npm run propose / MCP propose_context).
# Set one key; PROPOSAL_PROVIDER picks between them when several are present
# (anthropic | openai | gemini). PROPOSAL_MODEL overrides the vendor default model.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# PROPOSAL_PROVIDER=anthropic
# PROPOSAL_MODEL=claude-sonnet-4-5   # or gpt-4.1-mini / gemini-flash-latest; comma-separate fallbacks, e.g. gemini-3.8-flash,gemini-3.5-flash

# How your human edits/reviews are attributed in provenance when teammates share one database.
# OPERATOR_LABEL=your-name
