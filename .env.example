# Copy to .env (git-ignored). Every npm script and the Next.js dev server load it.
# Shell variables override this file — do not `export DATABASE_URL=…` in your terminal.

# --- Database ---------------------------------------------------------------
# Local: the Compose default below. Shared team graph: a hosted PostgreSQL URL
# (e.g. Neon; use the direct, non-pooled string with sslmode=verify-full), shared privately.
DATABASE_URL=postgresql://context_graph:context_graph_local@127.0.0.1:5432/context_graph
# DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/neondb?sslmode=verify-full

# Integration tests create/drop their own schemas here; keep this on the local database.
TEST_DATABASE_URL=postgresql://context_graph:context_graph_local@127.0.0.1:5432/context_graph

# --- Embeddings (context compiler / semantic search) ------------------------
# local (default): in-process ONNX sentence-transformer, no key, downloads once.
# openai: text-embedding-3-small via OPENAI_API_KEY.
EMBEDDING_PROVIDER=local
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- LLM for proposals (npm run propose / ingest:pr / ingest:docs / MCP tools) -
# Set ONE key. Without any key, proposal features are disabled and the MCP server
# omits propose_context / ingest_* tools.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
GEMINI_API_KEY=

# Which backend to use when several keys are present (anthropic | openai | gemini),
# and the model(s): comma-separated fallbacks are tried in order when one is throttled.
PROPOSAL_PROVIDER=gemini
PROPOSAL_MODEL=gemini-3.8-flash,gemini-3.5-flash,gemini-3.1-flash-lite
# PROPOSAL_MODEL=claude-sonnet-4-5        # Anthropic default
# PROPOSAL_MODEL=gpt-4.1-mini             # OpenAI default

# --- Attribution -------------------------------------------------------------
# How your edits/reviews appear in provenance when teammates share one database.
# A label, not a login.
OPERATOR_LABEL=your-name
