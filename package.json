{
  "name": "context-graph-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run .integration.test.ts",
    "build": "next build",
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "start": "next start -H 127.0.0.1 -p 3000",
    "db:migrate": "tsx src/server/db/migrate-cli.ts",
    "context:smoke": "tsx scripts/context-smoke.ts",
    "import:demo": "tsx scripts/import-demo.ts",
    "semantic:smoke": "tsx scripts/semantic-smoke.ts",
    "mcp": "tsx scripts/mcp-server.ts",
    "propose": "tsx scripts/propose.ts",
    "ingest:pr": "tsx scripts/ingest-pr.ts",
    "import:manifest": "tsx scripts/import-manifest.ts",
    "scan:repo": "tsx scripts/scan-repo.ts",
    "ingest:docs": "tsx scripts/ingest-docs.ts",
    "hof": "tsx scripts/hof.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^18.0.1",
    "js-tiktoken": "^1.0.21",
    "json-dup-key-validator": "^1.0.3",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "bin": {
    "hof": "scripts/hof.js"
  }
}
